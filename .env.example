# Backend / database
DATABASE_URL=postgresql://prlab:prlab@localhost:5432/prlab_assets
JWT_SECRET=your-secret-here

# Google OAuth (placeholders are fine for local dev without real login)
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# development / production -- controls CORS and other env-specific behaviour
APP_ENV=development

# Postgres credentials used by docker-compose
POSTGRES_USER=prlab
POSTGRES_PASSWORD=prlab
POSTGRES_DB=prlab_assets
